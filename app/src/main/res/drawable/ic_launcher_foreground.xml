<?xml version="1.0" encoding="utf-8"?><!--
    Launcher foreground: the app's signature crown mark (same silhouette as CrownIcon in
    PeakMap.kt), scaled to fit Android's adaptive-icon safe zone.

    Adaptive icons render on a 108x108dp canvas, but only the inner ~66x66dp is guaranteed
    visible across all launcher masks (circle, squircle, rounded square). This vector keeps
    the crown within that inner safe zone, centered on the 108x108 viewport.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <group android:scaleX="0.9"
      android:scaleY="0.9"
      android:translateX="5.4"
      android:translateY="5.4">
    <group android:scaleX="1.2"
        android:scaleY="1.2"
        android:translateX="-10.8"
        android:translateY="-10.8">
      <group android:scaleX="0.33"
          android:scaleY="0.33"
          android:translateX="36.18"
          android:translateY="36.18">
          <path
              android:fillColor="#FFE67E22"
              android:pathData="
              M0,108
              L0,0
              L27,54
              L54,0
              L81,54
              L108,0
              L108,108 Z" />
      </group>
    </group>
  </group>
</vector>
